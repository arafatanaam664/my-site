---
import BaseLayout from "../layouts/BaseLayout.astro";
import ShareActions from "./ShareActions.astro";
import RichContent from "./RichContent.astro";
import { labelForKind, sectionForKind, type PublicSection } from "../lib/content-taxonomy";
import { contentPageJsonLd, ogTypeForKind } from "../lib/content-schema";
import { contentPath } from "../lib/site-sections";
import { publicFeatureState } from "../lib/server/feature-gates";
import { mediaAbsoluteSrc, mediaForId, mediaSrc, relatedPublishedContent, type PublicContent } from "../lib/server/public-content";
import { builtInToolCatalog } from "../lib/tool-catalog";
import type { SiteSectionNode } from "../lib/site-sections";

interface Props { content: PublicContent; section: PublicSection; hub?: SiteSectionNode | null; subsection?: SiteSectionNode | null }
const { content, section, hub = null, subsection = null } = Astro.props;
const nestedPath = hub && subsection ? contentPath(content.kind, content.slug, hub.slug, subsection.slug) : `/${section}/${content.slug}`;
const canonical = content.canonical_url || `https://alshafra.com${nestedPath}`;
const title = content.seo_title || content.title;
const description = content.seo_description || content.excerpt || "مادة عملية من Alshafra.";
const primaryMedia = content.primary_media_id ? mediaForId(content, content.primary_media_id) : null;
const image = primaryMedia ? mediaAbsoluteSrc(primaryMedia.id, primaryMedia.width >= 1200 ? "hero" : "og") : undefined;
const publishedDate = new Intl.DateTimeFormat("ar-SA-u-ca-gregory", { dateStyle: "long" }).format(new Date(content.published_at));
const updatedDate = new Intl.DateTimeFormat("ar-SA-u-ca-gregory", { dateStyle: "long" }).format(new Date(content.updated_at));
const related = await relatedPublishedContent(content.kind, content.id);
const features = await publicFeatureState();
const tools = builtInToolCatalog.slice(0, 3);
const crumbs = [
  { name: "الرئيسية", url: "https://alshafra.com/" },
  ...(hub ? [{ name: hub.title, url: `https://alshafra.com${hub.href}` }] : [{ name: labelForKind(content.kind), url: `https://alshafra.com/${section}` }]),
  ...(subsection ? [{ name: subsection.title, url: `https://alshafra.com${subsection.href}` }] : []),
  { name: content.title, url: canonical },
];
const jsonLd = contentPageJsonLd({
  kind: content.kind,
  title: content.title,
  description,
  url: canonical,
  datePublished: content.published_at,
  dateModified: content.updated_at,
  image,
  imageWidth: primaryMedia?.width,
  imageHeight: primaryMedia?.height,
  body: content.body_html || content.body_markdown,
  sectionTitle: subsection?.title || labelForKind(content.kind),
}, crumbs);
---

<BaseLayout title={title} description={description} canonical={canonical} image={image} imageWidth={primaryMedia?.width} imageHeight={primaryMedia?.height} pageType={ogTypeForKind(content.kind)} publishedTime={content.published_at} modifiedTime={content.updated_at} jsonLd={jsonLd}>
  <article class="public-article" data-analytics-content-id={content.id}>
    <nav class="breadcrumbs" aria-label="مسار الصفحة">
      <a href="/">الرئيسية</a><span aria-hidden="true">/</span>
      {hub ? <a href={hub.href}>{hub.title}</a> : <a href={`/${section}`}>{labelForKind(content.kind)}</a>}
      {subsection && <><span aria-hidden="true">/</span><a href={subsection.href}>{subsection.title}</a></>}
      <span aria-hidden="true">/</span><span>{content.title}</span>
    </nav>
    <header class="article-header">
      <p class="eyebrow">{subsection?.title || labelForKind(content.kind)}</p>
      <h1>{content.title}</h1>
      {content.excerpt && <p class="article-excerpt">{content.excerpt}</p>}
      <div class="article-dates"><span>نُشر في {publishedDate}</span><span>آخر تحديث {updatedDate}</span></div>
      {features.social_sharing && <ShareActions title={content.title} url={canonical} />}
    </header>
    {primaryMedia && <figure class="article-hero"><img src={mediaSrc(primaryMedia.id, "hero")} srcset={`${mediaSrc(primaryMedia.id, "compact")} 480w, ${mediaSrc(primaryMedia.id, "standard")} 768w, ${mediaSrc(primaryMedia.id, "hero")} 1200w`} sizes="(max-width: 640px) 100vw, (max-width: 1024px) 768px, 1200px" alt={primaryMedia.alt_text} width={primaryMedia.width} height={primaryMedia.height} fetchpriority="high" /><figcaption>{primaryMedia.alt_text}</figcaption></figure>}
    <div class="article-layout">
      <div class="article-body">
        <RichContent content={content} />
        {related.length > 0 && <section class="related-content"><p class="eyebrow">تابع القراءة</p><h2>مواد ذات صلة</h2><div>{related.map((item) => { const itemSection = sectionForKind(item.kind) ?? section; return <a href={`/${itemSection}/${item.slug}`}><span>{labelForKind(item.kind)}</span><strong>{item.title}</strong><b aria-hidden="true">←</b></a>; })}</div></section>}
        {features.tools_core && tools.length > 0 && <section class="related-content"><p class="eyebrow">أدوات</p><h2>جرّب أداة مرتبطة</h2><div>{tools.map((tool) => <a href={tool.href}><span>أداة</span><strong>{tool.title}</strong><b aria-hidden="true">←</b></a>)}</div></section>}
      </div>
      <aside class="article-aside">
        <div><p class="eyebrow">معلومات المادة</p><p>هذه المادة منشورة بعد مراجعة تحريرية. راجع المصادر قبل الاعتماد على المعلومات الحساسة.</p></div>
        {content.sources.length > 0 && <div><h2>المصادر</h2><ol class="source-citations">{content.sources.map((source) => <li><a href={source.url} rel="noopener noreferrer" target="_blank">{source.title}</a>{source.publisher && <span>{source.publisher}</span>}</li>)}</ol></div>}
      </aside>
    </div>
  </article>
</BaseLayout>
