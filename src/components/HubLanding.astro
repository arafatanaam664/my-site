---
import { builtInToolCatalog } from "../lib/tool-catalog";
import type { SiteSectionNode } from "../lib/site-sections";
import { mediaForId, type PublicContentCard } from "../lib/server/public-content";
import { contentPath } from "../lib/site-sections";

interface Props {
  hub: SiteSectionNode;
  previews: Record<string, PublicContentCard[]>;
}
const { hub, previews } = Astro.props;
---

<section class="hub-page">
  <header class="content-index-header">
    <p class="eyebrow">قسم رئيسي</p>
    <h1>{hub.title}</h1>
    <p>{hub.description}</p>
  </header>
  <slot />
  <div class="hub-subsections">
    {hub.children.map((child) => {
      const items = previews[child.id] ?? [];
      return (
        <section class="hub-subsection">
          <div class="hub-subsection-heading">
            <div>
              <p class="eyebrow">قسم فرعي</p>
              <h2><a href={child.href}>{child.title}</a></h2>
              <p>{child.description}</p>
            </div>
            <a class="card-link" href={child.href}>عرض القسم <b aria-hidden="true">←</b></a>
          </div>
          {child.contentKind === "tool" ? (
            <div class="tool-catalog-grid">{builtInToolCatalog.slice(0, 3).map((tool) => <a class="tool-catalog-card" href={tool.href}><span>{tool.category}</span><h2>{tool.title}</h2><p>{tool.description}</p><small>{tool.mode === "client" ? "يعمل داخل متصفحك" : "يعتمد على خدمة خادمية"}</small><b aria-hidden="true">←</b></a>)}</div>
          ) : items.length ? (
            <div class="content-card-grid">{items.map((item) => {
              const media = item.primary_media_id ? mediaForId(item, item.primary_media_id) : null;
              const href = contentPath(item.kind, item.slug, hub.slug, child.slug);
              return <article class="content-card">{media && <img src={`/media/${media.id}?preset=compact`} alt={media.alt_text} width={media.width} height={media.height} loading="lazy" />}<div><span>{child.title}</span><h2><a href={href}>{item.title}</a></h2><p>{item.excerpt || item.seo_description || "مادة عملية من Alshafra."}</p><a class="card-link" href={href}>قراءة المادة <b aria-hidden="true">←</b></a></div></article>;
            })}</div>
          ) : (
            <div class="content-empty"><h3>لا توجد مواد منشورة هنا بعد</h3><p>تظهر المواد في هذا القسم الفرعي بعد اعتمادها ونشرها من لوحة التحكم.</p></div>
          )}
        </section>
      );
    })}
  </div>
</section>
