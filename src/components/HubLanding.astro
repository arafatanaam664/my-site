---
import type { SiteSectionNode } from "../lib/site-sections";
import type { PublicContentCard } from "../lib/server/public-content";
import ContentPreviewGrid from "./ContentPreviewGrid.astro";

interface Props {
  hub: SiteSectionNode;
  previews: Record<string, PublicContentCard[]>;
  toolsEnabled?: boolean;
}
const { hub, previews, toolsEnabled = true } = Astro.props;
---

<section class="hub-page">
  <header class="content-index-header">
    <p class="eyebrow">قسم رئيسي</p>
    <h1>{hub.title}</h1>
    <p>{hub.description}</p>
  </header>
  <slot />
  <div class="hub-subsections">
    {hub.children.map((child) => (
      <section class="hub-subsection">
        <div class="hub-subsection-heading">
          <div>
            <p class="eyebrow">قسم فرعي</p>
            <h2><a href={child.href}>{child.title}</a></h2>
            <p>{child.description}</p>
          </div>
          <a class="card-link" href={child.href}>عرض القسم <b aria-hidden="true">←</b></a>
        </div>
        <ContentPreviewGrid
          items={previews[child.id] ?? []}
          kicker={child.title}
          hubSlug={hub.slug}
          childSlug={child.slug}
          kind={child.contentKind}
          includeBuiltInTools={toolsEnabled && child.contentKind === "tool"}
          emptyTitle="لا توجد مواد منشورة هنا بعد"
          emptyBody="تظهر المواد في هذا القسم الفرعي بعد ربطها به من لوحة التحكم واعتمادها ونشرها."
        />
      </section>
    ))}
  </div>
</section>
