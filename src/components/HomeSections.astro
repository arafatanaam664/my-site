---
import type { SiteSectionNode } from "../lib/site-sections";
import type { PublicContentCard } from "../lib/server/public-content";
import ContentPreviewGrid from "./ContentPreviewGrid.astro";

interface Props {
  hubs: SiteSectionNode[];
  previews: Record<string, PublicContentCard[]>;
  toolsEnabled: boolean;
}

const { hubs, previews, toolsEnabled } = Astro.props;
---

<div class="home-hubs">
  {hubs.map((hub) => (
    <section class="home-hub section" id={`hub-${hub.slug}`}>
      <div class="section-heading">
        <div>
          <h2><a href={hub.href}>{hub.title}</a></h2>
          {hub.description && <p>{hub.description}</p>}
        </div>
        <a href={hub.href}>{hub.title} ←</a>
      </div>
      {hub.children.length ? hub.children.map((child) => (
        <div class="home-subsection">
          <div class="hub-subsection-heading">
            <div>
              <h3><a href={child.href}>{child.title}</a></h3>
              {child.description && <p>{child.description}</p>}
            </div>
            <a class="card-link" href={child.href}>{child.title} <b aria-hidden="true">←</b></a>
          </div>
          <ContentPreviewGrid
            items={previews[child.id] ?? []}
            kicker={child.title}
            hubSlug={hub.slug}
            childSlug={child.slug}
            kind={child.contentKind}
            includeBuiltInTools={toolsEnabled && child.contentKind === "tool"}
            emptyTitle={`لا توجد ${child.title} هنا بعد`}
            emptyBody="يمكنك تحويل التاريخ الهجري أو حساب العمر والنسبة من الأدوات، ثم العودة لاحقًا."
          />
        </div>
      )) : null}
    </section>
  ))}
</div>
