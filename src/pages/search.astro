---
import BaseLayout from "../layouts/BaseLayout.astro";
import { searchPublicContent } from "../lib/arabic-search";
import { labelForKind, sectionForKind } from "../lib/content-taxonomy";
import { allPublishedContent } from "../lib/server/public-content";
import { publicFeatureState } from "../lib/server/feature-gates";
import { searchAvailableTools } from "../lib/search-results";
import { publicExcerpt } from "../lib/public-copy";

export const prerender = false;
const query = (Astro.url.searchParams.get("q") ?? "").trim();
const results = query.length >= 2 ? searchPublicContent(await allPublishedContent(), query) : [];
const features = await publicFeatureState();
const toolResults = query.length >= 2 ? searchAvailableTools(query, features.tools_core) : [];
const totalResults = results.length + toolResults.length;
---

<BaseLayout title="بحث تحويل التاريخ الهجري والنسبة والخصم" description="ابحث عن تحويل التاريخ الهجري، تاريخ اليوم وفق أم القرى، حاسبة العمر، النسبة المئوية، والخصم." canonical="https://alshafra.com/search" noindex>
  <section class="search-page"><header><p class="eyebrow">تحويل التاريخ والحساب</p><h1>ابحث عن تحويل التاريخ أو النسبة</h1><p>اكتب عبارة مثل تحويل التاريخ الهجري، حاسبة العمر، أو حساب الخصم.</p></header><form class="search-form" action="/search" method="get"><label class="sr-only" for="search-query">ابحث عن تحويل التاريخ أو النسبة</label><input id="search-query" name="q" value={query} minlength="2" placeholder="مثال: تحويل التاريخ الهجري" /><button type="submit">بحث</button></form>{query.length > 0 && query.length < 2 && <p class="search-note">اكتب حرفين على الأقل لبدء البحث.</p>}{query.length >= 2 && <p class="search-note">{totalResults ? `وجدنا ${totalResults} نتيجة مرتبطة بعبارة «${query}».` : `لم نجد نتائج لتحويل التاريخ أو الحساب بعبارة «${query}».`}</p>}{toolResults.length > 0 && <section class="search-result-group" aria-labelledby="search-tools-heading"><h2 id="search-tools-heading">تحويل التاريخ والحساب</h2><ol class="search-results">{toolResults.map((tool) => <li><span>{tool.category}</span><h3><a href={tool.href}>{tool.title}</a></h3><p>{tool.description}</p></li>)}</ol></section>}{results.length > 0 && <section class="search-result-group" aria-labelledby="search-content-heading"><h2 id="search-content-heading">شرح التاريخ والمواعيد</h2><ol class="search-results">{results.map((item) => { const excerpt = publicExcerpt(item.excerpt, item.seo_description); return <li><span>{labelForKind(item.kind)}</span><h3><a href={`/${sectionForKind(item.kind) ?? "articles"}/${item.slug}`}>{item.title}</a></h3>{excerpt && <p>{excerpt}</p>}</li>; })}</ol></section>}</section>
</BaseLayout>
