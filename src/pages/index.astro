---
import BaseLayout from "../layouts/BaseLayout.astro";
import HomeSections from "../components/HomeSections.astro";
import { publicFeatureState } from "../lib/server/feature-gates";
import { publicNavigationTree } from "../lib/server/site-sections";
import { publishedContentForSection, type PublicContentCard } from "../lib/server/public-content";
import { collectionPageJsonLd } from "../lib/content-schema";

export const prerender = false;
const features = await publicFeatureState();
const hubs = await publicNavigationTree(features);
const previews: Record<string, PublicContentCard[]> = {};
await Promise.all(hubs.flatMap((hub) => hub.children.map(async (child) => {
  previews[child.id] = await publishedContentForSection(child.id, 4);
})));
const jsonLd = collectionPageJsonLd(
  "Alshafra",
  "أقسام المنصة الرئيسية وما يتبعها من أخبار ومقالات وأدوات ومحتوى منشور.",
  "https://alshafra.com/",
  hubs.flatMap((hub) => [{ name: hub.title, url: `https://alshafra.com${hub.href}` }, ...hub.children.map((child) => ({ name: child.title, url: `https://alshafra.com${child.href}` }))]),
);
---

<BaseLayout title="Alshafra | أدوات وحلول ومعلومات عملية بالعربية" description="اكتشف أدوات عملية وأدلة واضحة ومعلومات موثوقة تساعدك على إنجاز ما تحتاجه بالعربية." canonical="https://alshafra.com/" jsonLd={jsonLd}>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">معلومة موثوقة، وخطوة عملية</p>
      <h1>اعثر على ما تحتاجه، <em>ثم أنجزه.</em></h1>
      <p class="hero-description">Alshafra منصة عربية تجمع البحث والمحتوى والأدوات في مسار واحد: افهم المسألة، استخدم أداة، ثم انتقل إلى الخطوة التالية بثقة.</p>
      <div class="hero-actions">
        {features.tools_core && <a class="button button-primary" href="/tools">استكشف الأدوات</a>}
        {features.content_core && <a class="button button-secondary" href="/guides">تصفح الأدلة</a>}
        <a class="button button-secondary" href="/calendar">التقويم</a>
      </div>
    </div>
    <aside class="hero-paths" aria-label="مسارات الاستخدام">
      <p>ابدأ بما تريد إنجازه</p>
      {hubs.slice(0, 3).map((hub, index) => (
        <a href={hub.href}><span>{String(index + 1).padStart(2, "0")}</span><strong>{hub.title}</strong><b aria-hidden="true">←</b></a>
      ))}
    </aside>
  </section>

  {hubs.length > 0 ? (
    <HomeSections hubs={hubs} previews={previews} toolsEnabled={features.tools_core} />
  ) : (
    <section class="section">
      <div class="content-empty">
        <h2>لا توجد أقسام ظاهرة بعد</h2>
        <p>عندما تضيف قسمًا رئيسيًا وأقسامًا فرعية من لوحة التحكم وتنشر محتواها، تظهر هنا تلقائيًا.</p>
      </div>
    </section>
  )}

  <section id="search" class="search-section"><p class="eyebrow">ابدأ من حاجتك</p><h2>ما الذي تريد إنجازه اليوم؟</h2><form action="/search" role="search"><label class="sr-only" for="query">ابحث في المنصة</label><input id="query" name="q" placeholder="مثال: تحويل التاريخ الهجري أو حساب الخصم" /><button type="submit">بحث</button></form></section>
</BaseLayout>
