---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HubLanding from "../../components/HubLanding.astro";
import { breadcrumbListLd } from "../../lib/site-schema";
import { collectionPageJsonLd } from "../../lib/content-schema";
import { publicFeatureState } from "../../lib/server/feature-gates";
import { publicNavigationTree } from "../../lib/server/site-sections";
import { publishedContentForSection, type PublicContentCard } from "../../lib/server/public-content";

export const prerender = false;
const features = await publicFeatureState();
const navigation = await publicNavigationTree(features);
const hub = navigation.find((node) => node.slug === "calendar") ?? navigation[0];
const canonical = "https://alshafra.com/calendar";
const previews: Record<string, PublicContentCard[]> = {};
if (hub) {
  await Promise.all(hub.children.map(async (child) => {
    previews[child.id] = await publishedContentForSection(child.id, 4);
  }));
}
const jsonLd = [
  collectionPageJsonLd("التقويم والمواعيد", "تاريخ اليوم الهجري وفق أم القرى، وتحويل التاريخ الهجري والميلادي، وحساب العمر وفرق الأيام.", canonical, (hub?.children ?? []).map((child) => ({ name: child.title, url: `https://alshafra.com${child.href}` }))),
  breadcrumbListLd([{ name: "الرئيسية", url: "https://alshafra.com/" }, { name: "التقويم والمواعيد", url: canonical }]),
];
---

<BaseLayout title="التقويم الهجري وتاريخ اليوم وفق أم القرى" description="اعرف تاريخ اليوم الهجري والميلادي وفق أم القرى، وحوّل التاريخ واحسب العمر وفرق الأيام." canonical={canonical} jsonLd={jsonLd}>
  {hub ? (
    <HubLanding hub={hub} previews={previews} toolsEnabled={features.tools_core}>
      <div class="tool-catalog-grid hub-highlights">
        <a class="tool-catalog-card" href="/calendar/umm-al-qura"><span>تقويم أم القرى</span><h2>تاريخ اليوم الهجري وفق أم القرى</h2><p>التاريخ الهجري والميلادي اليوم مع وقت التحديث.</p><b aria-hidden="true">←</b></a>
        {features.tools_core && <a class="tool-catalog-card" href="/tools/hijri-converter"><span>تحويل التاريخ</span><h2>تحويل التاريخ الهجري إلى الميلادي</h2><p>حوّل بين الهجري والميلادي، مع التنبيه أن النتيجة قد تختلف عن أم القرى.</p><b aria-hidden="true">←</b></a>}
        {features.tools_core && <a class="tool-catalog-card" href="/tools/date-difference"><span>فرق الأيام</span><h2>حاسبة فرق الأيام بين تاريخين</h2><p>احسب عدد الأيام بين تاريخين ميلاديين.</p><b aria-hidden="true">←</b></a>}
        {features.tools_core && <a class="tool-catalog-card" href="/tools/countdown"><span>عدّاد تنازلي</span><h2>عدّاد تنازلي لتاريخ مستهدف</h2><p>الزمن المتبقي حتى تاريخ تختاره بالأيام والساعات.</p><b aria-hidden="true">←</b></a>}
      </div>
    </HubLanding>
  ) : (
    <section class="content-index"><header class="content-index-header"><h1>التقويم والمواعيد</h1></header></section>
  )}
</BaseLayout>
