---
import BaseLayout from "../layouts/BaseLayout.astro";
import HubLanding from "../components/HubLanding.astro";
import { isPublicSection, publicSectionMap } from "../lib/content-taxonomy";
import { collectionPageJsonLd } from "../lib/content-schema";
import { breadcrumbListLd } from "../lib/site-schema";
import { featureForPublicSection } from "../lib/platform-foundation";
import { publicFeatureState } from "../lib/server/feature-gates";
import { loadSiteSections, visibleSectionTree } from "../lib/server/site-sections";
import { publishedContentForSection, publishedContentList, type PublicContentCard } from "../lib/server/public-content";
import ContentPreviewGrid from "../components/ContentPreviewGrid.astro";
import { contentPath } from "../lib/site-sections";

export const prerender = false;
const section = Astro.params.section ?? "";
const features = await publicFeatureState();
const records = await loadSiteSections();
const hubs = visibleSectionTree(records, features);
const hub = hubs.find((node) => node.slug === section) ?? null;
const mapping = isPublicSection(section) ? publicSectionMap[section] : null;
const requiredFeature = featureForPublicSection(section);
const kindEnabled = !requiredFeature || features[requiredFeature];
const items = mapping && kindEnabled ? await publishedContentList(mapping.kind) : [];
const previews: Record<string, PublicContentCard[]> = {};
if (hub) {
  await Promise.all(hub.children.map(async (child) => {
    previews[child.id] = await publishedContentForSection(child.id, 4);
  }));
}
const showHub = Boolean(hub && section !== "calendar");
const showKind = Boolean(mapping && kindEnabled);
if (!showHub && !showKind) Astro.response.status = 404;
const canonical = `https://alshafra.com/${section}`;
---

{showHub && hub ? (
  <BaseLayout title={hub.title} description={hub.description} canonical={canonical} jsonLd={[collectionPageJsonLd(hub.title, hub.description, canonical, hub.children.map((child) => ({ name: child.title, url: `https://alshafra.com${child.href}` }))), breadcrumbListLd([{ name: "الرئيسية", url: "https://alshafra.com/" }, { name: hub.title, url: canonical }])]}>
    <HubLanding hub={hub} previews={previews} toolsEnabled={features.tools_core} />
  </BaseLayout>
) : showKind && mapping ? (
  <BaseLayout title={mapping.title} description={mapping.description} canonical={canonical} noindex={!items.length} jsonLd={[collectionPageJsonLd(mapping.title, mapping.description, canonical, items.map((item) => ({ name: item.title, url: `https://alshafra.com${contentPath(item.kind, item.slug)}` }))), breadcrumbListLd([{ name: "الرئيسية", url: "https://alshafra.com/" }, { name: mapping.title, url: canonical }])]}>
    <section class="content-index">
      <header class="content-index-header"><h1>{mapping.title}</h1><p>{mapping.description}</p></header>
      <ContentPreviewGrid items={items} kicker={mapping.singular} kind={mapping.kind} emptyTitle={`لا توجد ${mapping.title} بعد`} emptyBody="حوّل التاريخ الهجري أو احسب العمر والنسبة من الأدوات، ثم عد لاحقًا." />
    </section>
  </BaseLayout>
) : (
  <BaseLayout title="لم نعثر على هذه الصفحة" description="الصفحة المطلوبة غير متاحة حاليًا." noindex>
    <main class="not-found-page"><h1>لم نعثر على هذه الصفحة</h1><p>تحقق من الرابط أو عد إلى الرئيسية.</p><a class="button button-primary" href="/">العودة إلى الرئيسية</a></main>
  </BaseLayout>
)}
