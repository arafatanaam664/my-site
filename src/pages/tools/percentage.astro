---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ToolExtras from "../../components/ToolExtras.astro";
import { breadcrumbListLd, toolWebApplicationLd } from "../../lib/site-schema";
import { publicFeatureState } from "../../lib/server/feature-gates";
const features = await publicFeatureState();
if (!features.tools_core) Astro.response.status = 404;
const canonical = "https://alshafra.com/tools/percentage";
const title = "حاسبة النسبة المئوية";
const description = "احسب قيمة النسبة المئوية أو النسبة بين رقمين أو نسبة التغير، داخل المتصفح ودون إرسال الأرقام.";
---

{features.tools_core ? <BaseLayout title={title} description={description} canonical={canonical} jsonLd={[toolWebApplicationLd(title, description, canonical), breadcrumbListLd([{ name: "الرئيسية", url: "https://alshafra.com/" }, { name: "الأدوات", url: "https://alshafra.com/tools" }, { name: title, url: canonical }])]}>
  <section class="tool-page">
    <nav class="breadcrumbs" aria-label="مسار الصفحة"><a href="/">الرئيسية</a><span aria-hidden="true">/</span><a href="/tools">الأدوات</a><span aria-hidden="true">/</span><span>النسبة المئوية</span></nav>
    <header><p class="eyebrow">أداة عملية</p><h1>{title}</h1><p>اختر العملية ثم أدخل الأرقام. الحساب يتم داخل متصفحك.</p></header>
    <form class="date-offset-form" id="percentage-form">
      <label for="percentage-mode">العملية<select id="percentage-mode"><option value="of">ما قيمة النسبة من رقم؟</option><option value="ratio">كم تبلغ النسبة بين رقمين؟</option><option value="change">ما نسبة التغير؟</option></select></label>
      <label for="percentage-a">الرقم الأول<input id="percentage-a" type="number" step="any" required /></label>
      <label for="percentage-b">الرقم الثاني<input id="percentage-b" type="number" step="any" required /></label>
      <button type="submit">احسب</button>
    </form>
    <section class="tool-result" id="percentage-result" aria-live="polite" hidden><span>النتيجة</span><strong id="percentage-value"></strong><p id="percentage-copy"></p></section>
    <p class="tool-note">الأداة لا تحسب الضرائب أو العمولات الخاصة بجهة معينة. راجع مصدر الرقم عندما يكون القرار ماليًا.</p>
    <ToolExtras id="percentage" title={title} url={canonical} />
  </section>
</BaseLayout> : <BaseLayout title="لم نعثر على هذه الصفحة" description="الأداة غير متاحة حاليًا." noindex><main class="not-found-page"><h1>لم نعثر على هذه الصفحة</h1><p>الأداة غير متاحة حاليًا.</p><a class="button button-primary" href="/">العودة إلى الرئيسية</a></main></BaseLayout>}

<script>
  import { percentChange, percentOf, ratioToPercent } from "../../lib/percentage";
  import { trackToolUse } from "../../lib/tool-analytics";
  const form = document.querySelector<HTMLFormElement>("#percentage-form")!;
  const result = document.querySelector<HTMLElement>("#percentage-result")!;
  const value = document.querySelector<HTMLElement>("#percentage-value")!;
  const copy = document.querySelector<HTMLElement>("#percentage-copy")!;
  const number = new Intl.NumberFormat("ar-SA", { maximumFractionDigits: 4 });
  form.addEventListener("submit", (event) => {
    event.preventDefault();
    const mode = document.querySelector<HTMLSelectElement>("#percentage-mode")!.value;
    const a = Number(document.querySelector<HTMLInputElement>("#percentage-a")!.value);
    const b = Number(document.querySelector<HTMLInputElement>("#percentage-b")!.value);
    let computed: number | null = null;
    let detail = "";
    if (mode === "of") { computed = percentOf(a, b); detail = computed === null ? "" : `${number.format(a)}٪ من ${number.format(b)} تساوي ${number.format(computed)}.`; }
    else if (mode === "ratio") { computed = ratioToPercent(a, b); detail = computed === null ? "" : `${number.format(a)} تمثل ${number.format(computed)}٪ من ${number.format(b)}.`; }
    else { computed = percentChange(a, b); detail = computed === null ? "" : `التغير من ${number.format(a)} إلى ${number.format(b)} يبلغ ${number.format(computed)}٪.`; }
    if (computed === null) { copy.textContent = "تحقق من الأرقام. لا يمكن القسمة على صفر."; result.hidden = false; return; }
    value.textContent = number.format(computed);
    copy.textContent = detail;
    result.hidden = false;
    trackToolUse();
  });
</script>
