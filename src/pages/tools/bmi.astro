---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ToolExtras from "../../components/ToolExtras.astro";
import { breadcrumbListLd, toolWebApplicationLd } from "../../lib/site-schema";
import { publicFeatureState } from "../../lib/server/feature-gates";
const features = await publicFeatureState();
if (!features.tools_core) Astro.response.status = 404;
const canonical = "https://alshafra.com/tools/bmi";
const title = "حاسبة مؤشر كتلة الجسم";
const description = "احسب مؤشر كتلة الجسم من الوزن والطول وفق تصنيف منظمة الصحة العالمية، داخل المتصفح ودون إرسال بياناتك.";
---

{features.tools_core ? <BaseLayout title={title} description={description} canonical={canonical} jsonLd={[toolWebApplicationLd(title, description, canonical), breadcrumbListLd([{ name: "الرئيسية", url: "https://alshafra.com/" }, { name: "الأدوات", url: "https://alshafra.com/tools" }, { name: title, url: canonical }])]}>
  <section class="tool-page">
    <nav class="breadcrumbs" aria-label="مسار الصفحة"><a href="/">الرئيسية</a><span aria-hidden="true">/</span><a href="/tools">الأدوات</a><span aria-hidden="true">/</span><span>مؤشر كتلة الجسم</span></nav>
    <header><p class="eyebrow">أداة عملية</p><h1>{title}</h1><p>أدخل الوزن بالكيلوغرام والطول بالسنتيمتر. النتيجة تقديرية وليست تشخيصًا طبيًا.</p></header>
    <form class="date-difference-form" id="bmi-form">
      <label for="bmi-weight">الوزن (كغ)<input id="bmi-weight" type="number" min="1" max="400" step="any" required /></label>
      <label for="bmi-height">الطول (سم)<input id="bmi-height" type="number" min="50" max="250" step="any" required /></label>
      <button type="submit">احسب المؤشر</button>
    </form>
    <section class="tool-result" id="bmi-result" aria-live="polite" hidden><span>مؤشر كتلة الجسم</span><strong id="bmi-value"></strong><p id="bmi-copy"></p></section>
    <p class="tool-note">التصنيف وفق حدود منظمة الصحة العالمية الشائعة للبالغين. لا يغني عن استشارة مختص، ولا يناسب الأطفال أو الحوامل أو الرياضيين بنفس المعنى.</p>
    <ToolExtras id="bmi" title={title} url={canonical} />
  </section>
</BaseLayout> : <BaseLayout title="لم نعثر على هذه الصفحة" description="الأداة غير متاحة حاليًا." noindex><main class="not-found-page"><h1>لم نعثر على هذه الصفحة</h1><p>الأداة غير متاحة حاليًا.</p><a class="button button-primary" href="/">العودة إلى الرئيسية</a></main></BaseLayout>}

<script>
  import { bodyMassIndex } from "../../lib/bmi";
  import { trackToolUse } from "../../lib/tool-analytics";
  const form = document.querySelector<HTMLFormElement>("#bmi-form")!;
  const result = document.querySelector<HTMLElement>("#bmi-result")!;
  const value = document.querySelector<HTMLElement>("#bmi-value")!;
  const copy = document.querySelector<HTMLElement>("#bmi-copy")!;
  const number = new Intl.NumberFormat("ar-SA", { maximumFractionDigits: 1 });
  form.addEventListener("submit", (event) => {
    event.preventDefault();
    const weight = Number(document.querySelector<HTMLInputElement>("#bmi-weight")!.value);
    const height = Number(document.querySelector<HTMLInputElement>("#bmi-height")!.value);
    const computed = bodyMassIndex(weight, height);
    if (!computed) { copy.textContent = "تحقق من الوزن والطول ثم حاول مجددًا."; result.hidden = false; return; }
    value.textContent = number.format(computed.bmi);
    copy.textContent = `المؤشر ${number.format(computed.bmi)} — ${computed.label}.`;
    result.hidden = false;
    trackToolUse();
  });
</script>
