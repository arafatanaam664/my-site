---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { publicFeatureState } from "../../lib/server/feature-gates";
const features = await publicFeatureState();
if (!features.tools_core) Astro.response.status = 404;
---

{features.tools_core ? <BaseLayout title="معرفة يوم الأسبوع من التاريخ الميلادي" description="أدخل تاريخًا ميلاديًا لمعرفة يوم الأسبوع المقابل له داخل متصفحك، من دون إرسال تاريخك إلى الخادم." canonical="https://alshafra.com/tools/weekday-calculator">
  <section class="tool-page"><nav class="breadcrumbs" aria-label="مسار الصفحة"><a href="/">الرئيسية</a><span aria-hidden="true">/</span><a href="/tools">الأدوات</a><span aria-hidden="true">/</span><span>يوم الأسبوع</span></nav><header><p class="eyebrow">أداة عملية</p><h1>معرفة يوم الأسبوع من التاريخ الميلادي</h1><p>أدخل تاريخًا ميلاديًا صحيحًا لمعرفة يوم الأسبوع المقابل له. يجري الحساب داخل متصفحك، ولا نرسل تاريخ الإدخال إلى الخادم.</p></header><form class="date-offset-form" id="weekday-calculator-form"><label for="weekday-date">التاريخ الميلادي<input id="weekday-date" type="date" required /></label><button type="submit">اعرف يوم الأسبوع</button></form><section class="tool-result" id="weekday-calculator-result" aria-live="polite" hidden><span>يوم الأسبوع</span><strong id="weekday-calculator-value"></strong><p id="weekday-calculator-copy"></p></section><p class="tool-note">تستخدم الأداة التاريخ الميلادي فقط. راجع المصدر الأصلي عندما يتعلق التاريخ بموعد رسمي أو تقويم هجري أو تعليمات جهة مختصة.</p></section>
</BaseLayout> : <BaseLayout title="لم نعثر على هذه الصفحة" description="الأداة غير متاحة حاليًا." noindex><main class="not-found-page"><h1>لم نعثر على هذه الصفحة</h1><p>الأداة غير متاحة حاليًا.</p><a class="button button-primary" href="/">العودة إلى الرئيسية</a></main></BaseLayout>}

<script>
  import { weekdayForGregorianDate } from "../../lib/date-weekday";
  const form = document.querySelector<HTMLFormElement>("#weekday-calculator-form");
  const result = document.querySelector<HTMLElement>("#weekday-calculator-result");
  const value = document.querySelector<HTMLElement>("#weekday-calculator-value");
  const copy = document.querySelector<HTMLElement>("#weekday-calculator-copy");
  function trackUse() { if (localStorage.getItem("alshafra_analytics_consent_v1") !== "granted") return; const key = "alshafra_analytics_session_v1"; let sessionId = sessionStorage.getItem(key); if (!sessionId) { sessionId = crypto.randomUUID(); sessionStorage.setItem(key, sessionId); } const send = () => fetch("/api/analytics/event", { method: "POST", headers: { "content-type": "text/plain;charset=UTF-8" }, body: JSON.stringify({ path: location.pathname, eventType: "tool_use", contentId: null, durationSeconds: null, sessionId }), keepalive: true }).catch(() => {}); const pageWasTracked = sessionStorage.getItem("alshafra_tool_page_view") === location.pathname; if (pageWasTracked) void send(); else { sessionStorage.setItem("alshafra_tool_page_view", location.pathname); fetch("/api/analytics/event", { method: "POST", headers: { "content-type": "text/plain;charset=UTF-8" }, body: JSON.stringify({ path: location.pathname, eventType: "page_view", contentId: null, durationSeconds: null, sessionId }), keepalive: true }).then(send).catch(() => {}); } }
  form?.addEventListener("submit", (event) => { event.preventDefault(); const date = (document.querySelector<HTMLInputElement>("#weekday-date")!).value; const weekday = weekdayForGregorianDate(date); if (!result || !value || !copy) return; if (!weekday) { value.textContent = ""; copy.textContent = "تحقق من التاريخ ثم حاول مجددًا."; result.hidden = false; return; } const localized = new Intl.DateTimeFormat("ar-SA", { calendar: "gregory", dateStyle: "long", timeZone: "UTC" }).format(new Date(`${date}T00:00:00Z`)); value.textContent = weekday; copy.textContent = `التاريخ ${localized} يوافق يوم ${weekday}.`; result.hidden = false; trackUse(); });
</script>
