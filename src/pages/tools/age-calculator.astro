---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { publicFeatureState } from "../../lib/server/feature-gates";
const features = await publicFeatureState();
if (!features.tools_core) Astro.response.status = 404;
---

{features.tools_core ? <BaseLayout title="حاسبة العمر بالسنوات والأشهر والأيام" description="احسب العمر بين تاريخ الميلاد وتاريخ مرجعي تختاره، بنتيجة واضحة داخل متصفحك من دون إرسال التواريخ إلى الخادم." canonical="https://alshafra.com/tools/age-calculator">
  <section class="tool-page"><nav class="breadcrumbs" aria-label="مسار الصفحة"><a href="/">الرئيسية</a><span aria-hidden="true">/</span><a href="/tools">الأدوات</a><span aria-hidden="true">/</span><span>حاسبة العمر</span></nav><header><p class="eyebrow">أداة عملية</p><h1>حاسبة العمر بالسنوات والأشهر والأيام</h1><p>أدخل تاريخ الميلاد وتاريخًا مرجعيًا من اختيارك. يجري الحساب داخل متصفحك، ولا نرسل التاريخين إلى الخادم.</p></header><form class="date-difference-form" id="age-calculator-form"><label for="birth-date">تاريخ الميلاد<input id="birth-date" type="date" required /></label><label for="reference-date">التاريخ المرجعي<input id="reference-date" type="date" required /></label><button type="submit">احسب العمر</button></form><section class="tool-result" id="age-calculator-result" aria-live="polite" hidden><span>النتيجة</span><strong id="age-calculator-value"></strong><p id="age-calculator-copy"></p></section><p class="tool-note">تعرض الأداة فرقًا تقويميًا بين التاريخين. للمستندات أو المتطلبات الرسمية، راجع الجهة التي تحدد طريقة احتساب العمر.</p></section>
</BaseLayout> : <main class="not-found-page"><h1>لم نعثر على هذه الصفحة</h1><p>الأداة غير متاحة حاليًا.</p><a class="button button-primary" href="/">العودة إلى الرئيسية</a></main>}

<script>
  import { ageBetween } from "../../lib/age-calculator";
  const form = document.querySelector<HTMLFormElement>("#age-calculator-form")!;
  const result = document.querySelector<HTMLElement>("#age-calculator-result")!;
  const value = document.querySelector<HTMLElement>("#age-calculator-value")!;
  const copy = document.querySelector<HTMLElement>("#age-calculator-copy")!;
  const number = new Intl.NumberFormat("ar-SA");
  function trackUse() { if (localStorage.getItem("alshafra_analytics_consent_v1") !== "granted") return; const key = "alshafra_analytics_session_v1"; let sessionId = sessionStorage.getItem(key); if (!sessionId) { sessionId = crypto.randomUUID(); sessionStorage.setItem(key, sessionId); } const send = (eventType: "page_view" | "tool_use") => fetch("/api/analytics/event", { method: "POST", headers: { "content-type": "text/plain;charset=UTF-8" }, body: JSON.stringify({ path: location.pathname, eventType, contentId: null, durationSeconds: null, sessionId }), keepalive: true }).catch(() => {}); const pageWasTracked = sessionStorage.getItem("alshafra_tool_page_view") === location.pathname; if (pageWasTracked) void send("tool_use"); else { sessionStorage.setItem("alshafra_tool_page_view", location.pathname); void send("page_view").then(() => send("tool_use")); } }
  form.addEventListener("submit", (event) => { event.preventDefault(); const birth = (document.querySelector<HTMLInputElement>("#birth-date")!).value; const reference = (document.querySelector<HTMLInputElement>("#reference-date")!).value; const age = ageBetween(birth, reference); if (!age) { copy.textContent = "تحقق من التاريخين: يجب أن يكون تاريخ الميلاد صحيحًا وألا يأتي بعد التاريخ المرجعي."; result.hidden = false; return; } value.textContent = `${number.format(age.years)} سنة، ${number.format(age.months)} شهرًا، ${number.format(age.days)} يومًا`;
    copy.textContent = `بين ${birth} و${reference}: ${number.format(age.years)} سنة و${number.format(age.months)} شهرًا و${number.format(age.days)} يومًا.`; result.hidden = false; trackUse(); });
</script>
