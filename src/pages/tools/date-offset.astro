---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { publicFeatureState } from "../../lib/server/feature-gates";
const features = await publicFeatureState();
if (!features.tools_core) Astro.response.status = 404;
---

{features.tools_core ? <BaseLayout title="حاسبة تاريخ بعد عدد من الأيام" description="احسب تاريخًا مستقبليًا أو سابقًا بعد عدد محدد من الأيام، مع إبقاء التاريخ الذي تدخله داخل متصفحك." canonical="https://alshafra.com/tools/date-offset">
  <section class="tool-page"><nav class="breadcrumbs" aria-label="مسار الصفحة"><a href="/">الرئيسية</a><span aria-hidden="true">/</span><a href="/tools">الأدوات</a><span aria-hidden="true">/</span><span>حاسبة التاريخ</span></nav><header><p class="eyebrow">أداة عملية</p><h1>حاسبة تاريخ بعد عدد من الأيام</h1><p>اختر تاريخًا وعدد الأيام ثم حدد ما إذا كنت تريد الإضافة أو الطرح. يجري الحساب داخل متصفحك، ولا نرسل تاريخ الإدخال إلى الخادم.</p></header><form class="date-offset-form" id="date-offset-form"><label for="offset-date">التاريخ المرجعي<input id="offset-date" type="date" required /></label><label for="offset-days">عدد الأيام<input id="offset-days" type="number" min="0" max="36500" inputmode="numeric" required /></label><label for="offset-direction">العملية<select id="offset-direction"><option value="after">إضافة أيام</option><option value="before">طرح أيام</option></select></label><button type="submit">احسب التاريخ</button></form><section class="tool-result" id="date-offset-result" aria-live="polite" hidden><span>التاريخ الناتج</span><strong id="date-offset-value"></strong><p id="date-offset-copy"></p></section><p class="tool-note">تعتمد الأداة الأيام التقويمية، وليست أيام العمل أو المواعيد النظامية. راجع الجهة المختصة للمواعيد الرسمية أو الحساسة.</p></section>
</BaseLayout> : <BaseLayout title="لم نعثر على هذه الصفحة" description="الأداة غير متاحة حاليًا." noindex><main class="not-found-page"><h1>لم نعثر على هذه الصفحة</h1><p>الأداة غير متاحة حاليًا.</p><a class="button button-primary" href="/">العودة إلى الرئيسية</a></main></BaseLayout>}

<script>
  import { dateWithDayOffset } from "../../lib/date-offset";
  const form = document.querySelector<HTMLFormElement>("#date-offset-form")!;
  const result = document.querySelector<HTMLElement>("#date-offset-result")!;
  const value = document.querySelector<HTMLElement>("#date-offset-value")!;
  const copy = document.querySelector<HTMLElement>("#date-offset-copy")!;
  function trackUse() { if (localStorage.getItem("alshafra_analytics_consent_v1") !== "granted") return; const key = "alshafra_analytics_session_v1"; let sessionId = sessionStorage.getItem(key); if (!sessionId) { sessionId = crypto.randomUUID(); sessionStorage.setItem(key, sessionId); } const send = () => fetch("/api/analytics/event", { method: "POST", headers: { "content-type": "text/plain;charset=UTF-8" }, body: JSON.stringify({ path: location.pathname, eventType: "tool_use", contentId: null, durationSeconds: null, sessionId }), keepalive: true }).catch(() => {}); const pageWasTracked = sessionStorage.getItem("alshafra_tool_page_view") === location.pathname; if (pageWasTracked) void send(); else { sessionStorage.setItem("alshafra_tool_page_view", location.pathname); fetch("/api/analytics/event", { method: "POST", headers: { "content-type": "text/plain;charset=UTF-8" }, body: JSON.stringify({ path: location.pathname, eventType: "page_view", contentId: null, durationSeconds: null, sessionId }), keepalive: true }).then(send).catch(() => {}); } }
  form.addEventListener("submit", (event) => { event.preventDefault(); const date = (document.querySelector<HTMLInputElement>("#offset-date")!).value; const days = Number((document.querySelector<HTMLInputElement>("#offset-days")!).value); const direction = (document.querySelector<HTMLSelectElement>("#offset-direction")!).value as "after" | "before"; const next = dateWithDayOffset(date, days, direction); if (!next) { copy.textContent = "تحقق من التاريخ وعدد الأيام ثم حاول مجددًا."; result.hidden = false; return; } const localized = new Intl.DateTimeFormat("ar-SA", { calendar: "gregory", dateStyle: "long", timeZone: "UTC" }).format(new Date(`${next}T00:00:00Z`)); value.textContent = next; copy.textContent = `${direction === "after" ? "بعد" : "قبل"} ${new Intl.NumberFormat("ar-SA").format(days)} يومًا من ${date}: ${localized}.`; result.hidden = false; trackUse(); });
</script>
