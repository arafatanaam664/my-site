---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ToolExtras from "../../components/ToolExtras.astro";
import { breadcrumbListLd, toolWebApplicationLd } from "../../lib/site-schema";
import { publicFeatureState } from "../../lib/server/feature-gates";
const features = await publicFeatureState();
if (!features.tools_core) Astro.response.status = 404;
const canonical = "https://alshafra.com/tools/discount";
const title = "حاسبة الخصم والسعر النهائي";
const description = "أدخل السعر الأصلي ونسبة الخصم لمعرفة التوفير والسعر بعد التخفيض داخل المتصفح.";
---

{features.tools_core ? <BaseLayout title={title} description={description} canonical={canonical} jsonLd={[toolWebApplicationLd(title, description, canonical), breadcrumbListLd([{ name: "الرئيسية", url: "https://alshafra.com/" }, { name: "الأدوات", url: "https://alshafra.com/tools" }, { name: title, url: canonical }])]}>
  <section class="tool-page">
    <nav class="breadcrumbs" aria-label="مسار الصفحة"><a href="/">الرئيسية</a><span aria-hidden="true">/</span><a href="/tools">الأدوات</a><span aria-hidden="true">/</span><span>حاسبة الخصم</span></nav>
    <header><p class="eyebrow">حاسبة الخصم</p><h1>{title}</h1><p>أدخل السعر ونسبة الخصم لمعرفة التوفير والسعر النهائي.</p></header>
    <form class="date-difference-form" id="discount-form">
      <label for="discount-price">السعر الأصلي<input id="discount-price" type="number" min="0" step="any" required /></label>
      <label for="discount-percent">نسبة الخصم %<input id="discount-percent" type="number" min="0" max="100" step="any" required /></label>
      <button type="submit">احسب الخصم</button>
    </form>
    <section class="tool-result" id="discount-result" aria-live="polite" hidden><span>السعر بعد الخصم</span><strong id="discount-value"></strong><p id="discount-copy"></p></section>
    <p class="tool-note">الحساب لا يشمل الضرائب أو رسوم الشحن أو عروضًا مشروطة. راجع التاجر للسعر النهائي الملزم.</p>
    <ToolExtras id="discount" title={title} url={canonical} />
  </section>
</BaseLayout> : <BaseLayout title="لم نعثر على هذه الصفحة" description="الأداة غير متاحة حاليًا." noindex><main class="not-found-page"><h1>لم نعثر على هذه الصفحة</h1><p>الأداة غير متاحة حاليًا.</p><a class="button button-primary" href="/">العودة إلى الرئيسية</a></main></BaseLayout>}

<script>
  import { applyDiscount } from "../../lib/discount";
  import { trackToolUse } from "../../lib/tool-analytics";
  const form = document.querySelector<HTMLFormElement>("#discount-form")!;
  const result = document.querySelector<HTMLElement>("#discount-result")!;
  const value = document.querySelector<HTMLElement>("#discount-value")!;
  const copy = document.querySelector<HTMLElement>("#discount-copy")!;
  const number = new Intl.NumberFormat("ar-SA", { maximumFractionDigits: 2 });
  form.addEventListener("submit", (event) => {
    event.preventDefault();
    const price = Number(document.querySelector<HTMLInputElement>("#discount-price")!.value);
    const percent = Number(document.querySelector<HTMLInputElement>("#discount-percent")!.value);
    const computed = applyDiscount(price, percent);
    if (!computed) { copy.textContent = "تحقق من السعر ونسبة الخصم بين 0 و100."; result.hidden = false; return; }
    value.textContent = number.format(computed.final);
    copy.textContent = `التوفير ${number.format(computed.savings)}، والسعر بعد خصم ${number.format(percent)}٪ هو ${number.format(computed.final)}.`;
    result.hidden = false;
    trackToolUse();
  });
</script>
