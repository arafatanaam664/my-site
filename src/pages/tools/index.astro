---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { builtInToolCatalog } from "../../lib/tool-catalog";
import { publicFeatureState } from "../../lib/server/feature-gates";
import { publishedContentList } from "../../lib/server/public-content";
import { publicExcerpt } from "../../lib/public-copy";

export const prerender = false;
const [features, publishedTools] = await Promise.all([publicFeatureState(), publishedContentList("tool")]);
if (!features.tools_core) Astro.response.status = 404;
---

{features.tools_core ? <BaseLayout title="تحويل التاريخ الهجري وحاسبة العمر والنسبة والخصم" description="حوّل التاريخ الهجري، احسب العمر وفرق الأيام والنسبة المئوية والخصم، واعرف يوم الأسبوع بالعربية." canonical="https://alshafra.com/tools"><section class="tool-catalog"><header class="content-index-header"><p class="eyebrow">تحويل التاريخ والحساب</p><h1>تحويل التاريخ الهجري وحاسبة العمر والنسبة</h1><p>حوّل بين الهجري والميلادي، احسب العمر وفرق الأيام، واحسب النسبة المئوية والخصم.</p></header><div class="tool-catalog-grid">{builtInToolCatalog.map((tool) => <a class="tool-catalog-card" href={tool.href}><span>{tool.category}</span><h2>{tool.title}</h2><p>{tool.description}</p><b aria-hidden="true">←</b></a>)}</div>{publishedTools.length > 0 && <section class="catalog-published-tools"><p class="eyebrow">حساب وتقويم</p><h2>المزيد من أدوات التاريخ والحساب</h2><div>{publishedTools.map((tool) => { const excerpt = publicExcerpt(tool.excerpt, tool.seo_description); return <a href={`/tools/${tool.slug}`}><strong>{tool.title}</strong>{excerpt && <span>{excerpt}</span>}<b aria-hidden="true">←</b></a>; })}</div></section>}</section></BaseLayout> : <BaseLayout title="لم نعثر على هذه الصفحة" description="صفحة تحويل التاريخ والحساب غير متاحة حاليًا." noindex><main class="not-found-page"><h1>لم نعثر على هذه الصفحة</h1><p>حوّل التاريخ من الرئيسية أو اعرف تاريخ اليوم وفق أم القرى.</p><a class="button button-primary" href="/">العودة إلى الرئيسية</a></main></BaseLayout>}
