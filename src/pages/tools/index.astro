---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { builtInToolCatalog } from "../../lib/tool-catalog";
import { publicFeatureState } from "../../lib/server/feature-gates";
import { publishedContentList } from "../../lib/server/public-content";

export const prerender = false;
const [features, publishedTools] = await Promise.all([publicFeatureState(), publishedContentList("tool")]);
if (!features.tools_core) Astro.response.status = 404;
---

{features.tools_core ? <BaseLayout title="أدوات Alshafra العملية" description="كتالوج أدوات عملية عربية تساعدك على الوصول إلى نتيجة واضحة مع شرح وحدود استخدام معلنة." canonical="https://alshafra.com/tools"><section class="tool-catalog"><header class="content-index-header"><p class="eyebrow">كتالوج الأدوات</p><h1>أدوات تبدأ بمهمة واضحة</h1><p>لا نعرض هنا إلا أداة متاحة فعليًا. لكل أداة غرض محدد، وحدود استخدام معلنة، ونتيجة قابلة للفهم.</p></header><div class="tool-catalog-grid">{builtInToolCatalog.map((tool) => <a class="tool-catalog-card" href={tool.href}><span>{tool.category}</span><h2>{tool.title}</h2><p>{tool.description}</p><small>{tool.mode === "client" ? "يعمل داخل متصفحك" : "يعتمد على خدمة خادمية"}</small><b aria-hidden="true">←</b></a>)}</div>{publishedTools.length > 0 && <section class="catalog-published-tools"><p class="eyebrow">أدوات موثقة</p><h2>مواد وأدوات منشورة</h2><div>{publishedTools.map((tool) => <a href={`/tools/${tool.slug}`}><strong>{tool.title}</strong><span>{tool.excerpt || tool.seo_description || "صفحة أداة منشورة."}</span><b aria-hidden="true">←</b></a>)}</div></section>}</section></BaseLayout> : <BaseLayout title="لم نعثر على هذه الصفحة" description="قسم الأدوات غير متاح حاليًا." noindex><main class="not-found-page"><h1>لم نعثر على هذه الصفحة</h1><p>قسم الأدوات غير متاح حاليًا.</p><a class="button button-primary" href="/">العودة إلى الرئيسية</a></main></BaseLayout>}
