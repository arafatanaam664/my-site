---
import PublicContentPage from "../../components/PublicContentPage.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { isPublicSection, publicSectionMap } from "../../lib/content-taxonomy";
import { featureForPublicSection } from "../../lib/platform-foundation";
import { publicFeatureState } from "../../lib/server/feature-gates";
import { publishedContent } from "../../lib/server/public-content";

export const prerender = false;
const section = Astro.params.section ?? "";
const mapping = isPublicSection(section) ? publicSectionMap[section] : undefined;
const slug = Astro.params.slug ?? "";
const features = await publicFeatureState(); const enabled = mapping ? features[featureForPublicSection(section) ?? "content_core"] : false;
const content = mapping && enabled && slug ? await publishedContent(mapping.kind, slug) : null;
if (!content) Astro.response.status = 404;
---

{content && mapping && isPublicSection(section) ? <PublicContentPage content={content} section={section} /> : <BaseLayout title="لم نعثر على هذه الصفحة" description="المادة المطلوبة غير متاحة للعامة." noindex><main class="not-found-page"><h1>لم نعثر على هذه الصفحة</h1><p>قد يكون الرابط غير صحيح، أو أن المادة لم تعد متاحة للعامة.</p><a class="button button-primary" href="/">العودة إلى الرئيسية</a></main></BaseLayout>}
