---
export const prerender = false;

import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="إدارة Alshafra" description="لوحة إدارة المحتوى لمنصة Alshafra." canonical="https://alshafra.com/admin">
  <section class="admin-shell">
    <div class="admin-heading"><p class="eyebrow">مساحة المحرر</p><h1>إدارة المحتوى</h1><p>أنشئ المواد، راجعها، وانشرها عبر تسلسل واضح. لا تُعرض أي مادة للعامة إلا بعد اعتمادها ونشرها.</p></div>

    <section class="admin-card" id="auth-card">
      <h2>الدخول إلى مساحة التحرير</h2>
      <p>أدخل بريدك المعتمد. سنرسل رابط دخول آمن بدل كلمة مرور.</p>
      <form id="magic-link-form" onsubmit="document.getElementById('auth-status').textContent = 'تعذر تحميل وظائف الإدارة في هذه المعاينة. حدّث الصفحة أو افتح رابط المعاينة في المتصفح ثم أعد المحاولة.'; return false;"><label for="editor-email">البريد الإلكتروني</label><input id="editor-email" type="email" autocomplete="email" required placeholder="name@example.com" /><button type="submit">إرسال رابط الدخول</button></form>
      <section id="development-access-card" class="development-access-card" hidden><p><strong>دخول التطوير المؤقت</strong> متاح لهذه المعاينة فقط. أدخل رمز الوصول المحفوظ بأمان؛ لا يعمل على النطاق النهائي.</p><form id="development-access-form" onsubmit="document.getElementById('development-access-status').textContent = 'تعذر تحميل وظائف التطوير في هذه المعاينة. حدّث الصفحة أو افتحها في المتصفح.'; return false;"><label for="development-access-code">رمز وصول التطوير</label><input id="development-access-code" type="password" autocomplete="current-password" minlength="16" required /><button type="submit">فتح جلسة تطوير</button></form><p class="form-status" id="development-access-status" aria-live="polite"></p></section>
      <p class="form-status" id="auth-status" aria-live="polite"></p>
    </section>

    <section class="admin-panel admin-console" id="dashboard" hidden>
      <div class="admin-console-top"><div><span class="eyebrow">غرفة العمليات</span><h2>مرحبًا بك في لوحة Alshafra</h2><p>نظرة عملية على المحتوى والقياس وإتاحة الوحدات، من دون أرقام مصطنعة أو وعود غير قابلة للتحقق.</p></div><button type="button" id="admin-logout" class="subtle-button">تسجيل الخروج</button></div>
      <div class="admin-console-layout"><aside class="admin-sidebar" aria-label="تنقل لوحة الإدارة"><div class="admin-sidebar-label">مساحة العمل</div><button type="button" class="admin-nav-button" data-admin-nav="overview" aria-current="page"><span aria-hidden="true">◈</span> الملخص</button><button type="button" class="admin-nav-button" data-admin-nav="content"><span aria-hidden="true">✎</span> المحتوى</button><button type="button" class="admin-nav-button" data-admin-nav="analytics"><span aria-hidden="true">⌁</span> القياس</button><button type="button" class="admin-nav-button" data-admin-nav="community"><span aria-hidden="true">◌</span> المجتمع</button><button type="button" class="admin-nav-button" data-admin-nav="distribution"><span aria-hidden="true">↗</span> التوزيع</button><button type="button" class="admin-nav-button" data-admin-nav="settings" id="admin-settings-nav"><span aria-hidden="true">⚙</span> الإعدادات</button><div class="admin-sidebar-note"><strong>سير العمل</strong><span>مسودة ← مراجعة ← اعتماد ← نشر</span></div></aside><div class="admin-console-content">
      <section class="admin-overview" id="admin-overview" data-admin-view="overview"><div class="admin-view-heading"><div><span class="eyebrow">الملخص</span><h3>ابدأ من خطوة واضحة</h3><p>تعرض هذه الصفحة ما يتوفر فعلًا في المنصة، وتوجّهك إلى الإجراء التالي بدل ملئها بمؤشرات افتراضية.</p></div><button type="button" id="open-draft-composer">مادة جديدة</button></div><div class="admin-overview-metrics"><article><span>مسودات قابلة للعمل</span><strong id="overview-drafts">—</strong><small>من قائمة المحتوى الحالية</small></article><article><span>مواد منشورة</span><strong id="overview-published">—</strong><small>تظهر فقط بعد النشر المعتمد</small></article><article><span>زيارات مجهّلة</span><strong id="overview-visits">—</strong><small>ضمن الفترة المختارة للقياس</small></article></div><div class="admin-next-actions"><article><span class="eyebrow">الإجراء التالي</span><h4 id="overview-next-step">أنشئ مسودة موثقة لتبدأ دورة التحرير.</h4><p>أضف النص والمصدر والصورة الرئيسية ثم مرّر المادة عبر المراجعة قبل النشر.</p><button type="button" class="subtle-button" id="open-content-queue">فتح طابور المحتوى</button></article><article><span class="eyebrow">حالة الإتاحة</span><h4>الوحدات الجديدة تبقى متوقفة</h4><p>يمكن للمدير فقط تفعيل وحدة بعد اكتمال واجهتها واختبارها؛ لا تظهر الوظائف غير الجاهزة للزائر.</p><button type="button" class="subtle-button" id="open-settings-workspace">عرض الإعدادات</button></article></div></section>
      <div class="admin-toolbar" data-admin-view="content" hidden><div><span class="eyebrow">المحتوى</span><h2>طابور التحرير</h2><p>أنشئ المواد، راجعها، ثم انشرها فقط بعد اكتمال معايير الجودة.</p></div><div class="admin-toolbar-actions"><button type="button" id="refresh-content" class="subtle-button">تحديث القائمة</button><button type="button" id="open-draft-from-toolbar">مسودة جديدة</button></div></div>
      <section class="analytics-panel" data-admin-view="analytics" hidden><div class="admin-toolbar"><div><span class="eyebrow">تحليلات خصوصية</span><h2>أداء المحتوى</h2><p>تعتمد هذه الأرقام على الزوار الذين اختاروا القياس المجهّل. لا تُعرض أي بيانات شخصية أو سجلات متخيلة.</p></div><label class="analytics-range" for="analytics-range">الفترة<select id="analytics-range"><option value="day">آخر 24 ساعة</option><option value="week">آخر 7 أيام</option><option value="month" selected>آخر 30 يومًا</option><option value="year">آخر 12 شهرًا</option></select></label></div><div class="analytics-totals" id="analytics-totals"><p>يجري تحميل التقرير…</p></div><div class="analytics-table-wrap"><table><thead><tr><th>الصفحة أو المادة</th><th>مشاهدات</th><th>زيارات مجهّلة</th><th>بلغ 50%</th><th>إكمال القراءة</th><th>متوسط القراءة</th></tr></thead><tbody id="analytics-rows"><tr><td colspan="6">لا توجد بيانات معروضة بعد.</td></tr></tbody></table></div></section>
      <section class="social-distribution-panel" data-admin-view="distribution" hidden><div class="admin-toolbar"><div><span class="eyebrow">توزيع يدوي</span><h2>مساحة النشر الاجتماعي</h2><p>جهّز نصوصًا قابلة للنسخ وسجّل الخطوة اليدوية. لا تتصل هذه المساحة بحسابات خارجية ولا تنشر تلقائيًا.</p></div></div><p class="social-distribution-notice"><strong>حد الأمان:</strong> لا تضع كلمة مرور أو رمز وصول أو مفتاح API في أي حقل هنا.</p><div class="social-distribution-forms"><form class="admin-card" id="social-account-form"><h3>حساب مرجعي</h3><label for="social-account-provider">المنصة</label><select id="social-account-provider"><option value="x">X</option><option value="facebook">Facebook</option><option value="instagram">Instagram</option><option value="linkedin">LinkedIn</option><option value="telegram">Telegram</option><option value="whatsapp_channel">قناة WhatsApp</option><option value="other">أخرى</option></select><label for="social-account-name">اسم واضح للحساب</label><input id="social-account-name" minlength="2" maxlength="120" required placeholder="مثال: قناة المنصة الرسمية" /><label for="social-account-ref">معرّف عام أو رابط مختصر (اختياري)</label><input id="social-account-ref" maxlength="240" placeholder="@alshafra أو رابط عام" /><label for="social-account-status">حالة المرجع</label><select id="social-account-status"><option value="disconnected">غير متصل</option><option value="ready">جاهز يدويًا</option><option value="paused">متوقف مؤقتًا</option></select><button type="submit">حفظ الحساب المرجعي</button><p class="form-status" id="social-account-status-message" aria-live="polite"></p></form><form class="admin-card" id="social-template-form"><h3>قالب منشور</h3><label for="social-template-name">اسم القالب</label><input id="social-template-name" minlength="2" maxlength="100" required placeholder="إعلان دليل جديد" /><label for="social-template-provider">المنصة المستهدفة</label><select id="social-template-provider"><option value="">عام لجميع المنصات</option><option value="x">X</option><option value="facebook">Facebook</option><option value="instagram">Instagram</option><option value="linkedin">LinkedIn</option><option value="telegram">Telegram</option><option value="whatsapp_channel">قناة WhatsApp</option><option value="other">أخرى</option></select><label for="social-template-body">النص</label><textarea id="social-template-body" minlength="20" maxlength="5000" required placeholder="استخدم {{title}} و{{excerpt}} و{{url}} عند الحاجة."></textarea><button type="submit">حفظ القالب</button><p class="form-status" id="social-template-status" aria-live="polite"></p></form><form class="admin-card" id="social-outbox-form"><h3>صندوق النسخ</h3><label for="social-outbox-account">الحساب المرجعي (اختياري)</label><select id="social-outbox-account"><option value="">دون حساب محدد</option></select><label for="social-outbox-content">مادة منشورة</label><select id="social-outbox-content"><option value="">اختر مادة منشورة</option></select><label for="social-outbox-template">قالب مفعّل</label><select id="social-outbox-template"><option value="">اختر قالبًا</option></select><button type="button" id="prepare-social-outbox" class="subtle-button">تجهيز من المادة والقالب</button><label for="social-outbox-body">أو اكتب نصًا يدويًا</label><textarea id="social-outbox-body" minlength="1" maxlength="5000" required placeholder="اكتب النص النهائي الذي ستنسخه للنشر اليدوي."></textarea><label for="social-outbox-url">رابط الوجهة HTTPS (اختياري)</label><input id="social-outbox-url" type="url" placeholder="https://alshafra.com/..." /><label for="social-outbox-status">الحالة</label><select id="social-outbox-status"><option value="draft">مسودة</option><option value="ready">جاهز للنسخ</option></select><button type="submit">إضافة إلى الصندوق</button><p class="form-status" id="social-outbox-status-message" aria-live="polite"></p></form></div><div class="social-distribution-lists"><article><h3>الحسابات المرجعية</h3><ul class="social-list" id="social-accounts-list"><li>يجري التحميل…</li></ul></article><article><h3>القوالب المحفوظة</h3><ul class="social-list" id="social-templates-list"><li>يجري التحميل…</li></ul></article><article><h3>المنشورات الجاهزة</h3><ul class="social-list" id="social-outbox-list"><li>يجري التحميل…</li></ul></article></div><section class="social-activity"><h3>سجل الخطوات اليدوية</h3><ol id="social-activity-list"><li>يجري التحميل…</li></ol></section><p class="form-status" id="social-distribution-status" aria-live="polite"></p></section>
      <section class="admin-card" id="feature-flags-panel" data-admin-view="settings" hidden><div class="admin-toolbar"><div><span class="eyebrow">إتاحة المنصة</span><h2>مفاتيح الميزات</h2><p>لا تفعّل أي وحدة قبل اكتمال واجهتها وصلاحياتها واختباراتها. لا تظهر الوحدات الموقوفة للجمهور.</p></div></div><div id="feature-flags-list" class="feature-flags-list"></div><p class="form-status" id="feature-flags-status" aria-live="polite"></p></section>
      <section class="admin-card" id="platform-settings-panel" data-admin-view="settings" hidden><div class="admin-toolbar"><div><span class="eyebrow">إعدادات المنصة</span><h2>التنبيه العام</h2><p>رسالة مؤقتة واضحة للزوار عند الحاجة. لا تستخدمها للوعود أو المعلومات الحساسة.</p></div></div><form id="site-notice-form"><label class="feature-flag-control"><input id="site-notice-enabled" type="checkbox" /><span>إظهار التنبيه للزوار</span></label><label for="site-notice-message">نص التنبيه</label><textarea id="site-notice-message" maxlength="240" placeholder="مثال: قد تتأخر بعض التحديثات المؤقتة اليوم."></textarea><button type="submit">حفظ التنبيه</button></form><p class="form-status" id="platform-settings-status" aria-live="polite"></p></section>
      <div class="admin-grid" data-admin-view="content" hidden>
        <form id="new-draft-form" class="admin-card"><h3>مسودة جديدة</h3><label for="draft-kind">نوع المادة</label><select id="draft-kind"><option value="article">مقال</option><option value="guide">دليل</option><option value="page">صفحة</option><option value="tool">أداة</option></select><label for="draft-title">العنوان</label><input id="draft-title" minlength="15" maxlength="160" required /><label for="draft-slug">الرابط المختصر (إنجليزي)</label><input id="draft-slug" pattern="[a-z0-9]+(?:-[a-z0-9]+)*" required placeholder="hijri-date-conversion-guide" /><label for="draft-excerpt">وصف مختصر</label><textarea id="draft-excerpt" maxlength="320"></textarea><fieldset class="media-fieldset"><legend>الصورة الرئيسية (اختياري)</legend><label for="primary-image">ملف الصورة</label><input id="primary-image" type="file" accept="image/avif,image/webp,image/jpeg,image/png" /><label for="primary-image-alt">وصف بديل للصورة</label><input id="primary-image-alt" minlength="5" maxlength="180" placeholder="وصف موجز ودقيق لما يظهر في الصورة" /><p class="field-note">JPEG أو PNG أو WebP أو AVIF، حتى 10MB. لا تُستخدم الصورة إلا بعد ربطها بالمادة.</p></fieldset><button type="submit">إنشاء المسودة</button><p class="form-status" id="draft-status" aria-live="polite"></p></form>
        <div class="admin-card"><h3>آخر المواد</h3><ul id="content-list" class="content-list"><li>يجري تحميل المحتوى…</li></ul></div>
      </div>

	      <section class="admin-editor" id="editor-panel" data-admin-view="content" hidden>
        <div class="admin-toolbar"><div><span class="eyebrow">تحرير</span><h2 id="editor-heading">المسودة</h2></div><p class="status-pill" id="workflow-status">مسودة</p></div>
        <form id="edit-draft-form" class="editor-form">
          <div class="editor-main"><label for="edit-title">العنوان</label><input id="edit-title" minlength="15" maxlength="160" required /><label for="edit-excerpt">الوصف المختصر</label><textarea id="edit-excerpt" maxlength="320"></textarea><label for="edit-body">نص المادة</label><textarea id="edit-body" class="content-textarea" maxlength="100000" placeholder="اكتب المحتوى بصيغة Markdown. استخدم زر الصورة لإدراجها في موضع المؤشر."></textarea><fieldset class="media-fieldset"><legend>صورة داخل النص</legend><label for="inline-image">ملف الصورة</label><input id="inline-image" type="file" accept="image/avif,image/webp,image/jpeg,image/png" /><label for="inline-image-alt">وصف بديل للصورة</label><input id="inline-image-alt" minlength="5" maxlength="180" placeholder="وصف موجز ودقيق لما يظهر في الصورة" /><button type="button" class="inline-media-button" id="insert-inline-image">رفع وإدراج عند موضع المؤشر</button><p class="field-note" id="inline-image-status" aria-live="polite">احفظ المسودة بعد الإدراج لتربط الصورة بالمادة.</p></fieldset><fieldset class="media-fieldset"><legend>استبدال الصورة الرئيسية</legend><label for="edit-primary-image">ملف الصورة</label><input id="edit-primary-image" type="file" accept="image/avif,image/webp,image/jpeg,image/png" /><label for="edit-primary-image-alt">وصف بديل للصورة الجديدة</label><input id="edit-primary-image-alt" minlength="5" maxlength="180" placeholder="اكتب هذا الوصف فقط عند اختيار ملف جديد" /></fieldset></div>
          <aside class="editor-side"><h3>إعدادات الظهور</h3><label for="edit-seo-title">عنوان نتائج البحث</label><input id="edit-seo-title" maxlength="60" /><label for="edit-seo-description">وصف نتائج البحث</label><textarea id="edit-seo-description" maxlength="160"></textarea><label for="edit-canonical">الرابط القانوني</label><input id="edit-canonical" type="url" placeholder="https://alshafra.com/..." /><label for="edit-note">ملاحظة المراجعة</label><textarea id="edit-note" maxlength="500" placeholder="تلخيص ما تغير في هذه النسخة"></textarea><button type="submit">حفظ المسودة وسجل المراجعة</button><p class="form-status" id="edit-status" aria-live="polite"></p></aside>
        </form>
        <div class="workflow-actions" id="workflow-actions" hidden><p>انتقال الحالة:</p><button type="button" class="subtle-button" id="workflow-next"></button><p class="form-status" id="workflow-message" aria-live="polite"></p></div>
        <section class="source-manager"><div class="admin-toolbar"><div><span class="eyebrow">التوثيق</span><h3>مصادر المادة</h3></div><button type="button" class="subtle-button" id="add-source">إضافة مصدر</button></div><div id="source-list" class="source-list"></div><button type="button" id="save-sources" class="source-save">حفظ المصادر</button><p class="form-status" id="source-status" aria-live="polite"></p></section>
	        <section class="revision-history"><div><span class="eyebrow">التدقيق</span><h3>سجل المراجعات</h3></div><ol id="history-list" class="history-list"><li>افتح مادة لعرض سجلها.</li></ol></section>
	      </section>
	      <section class="community-moderation-panel" data-admin-view="community" hidden><div class="admin-toolbar"><div><span class="eyebrow">مجتمع مقفل</span><h2>طابور الإشراف</h2><p>هذه مساحة مراجعة داخلية فقط. لا تفتح المجتمع للزوار ولا تقبل أي إدخال جديد؛ يبقى مفتاح المجتمع متوقفًا حتى اكتمال الحماية والمراجعات.</p></div><button type="button" class="subtle-button" id="refresh-community-moderation">تحديث الطابور</button></div><p class="community-moderation-notice"><strong>قاعدة النشر:</strong> راجع السياق والجودة والسلامة قبل النشر. كل قرار هنا يسجل في سجل الإشراف.</p><label class="community-moderation-note" for="community-moderation-note">ملاحظة القرار (اختيارية)<textarea id="community-moderation-note" maxlength="1000" placeholder="سبب موجز وموضوعي للقرار، يظهر في سجل التدقيق الداخلي."></textarea></label><div class="community-moderation-grid"><article><h3>أسئلة تنتظر المراجعة</h3><ul class="moderation-list" id="community-questions-list"><li>يجري التحميل…</li></ul></article><article><h3>إجابات تنتظر المراجعة</h3><ul class="moderation-list" id="community-answers-list"><li>يجري التحميل…</li></ul></article><article><h3>بلاغات مفتوحة</h3><ul class="moderation-list" id="community-reports-list"><li>يجري التحميل…</li></ul></article></div><section class="community-moderation-history"><h3>آخر قرارات الإشراف</h3><ol id="community-actions-list"><li>يجري التحميل…</li></ol></section><p class="form-status" id="community-moderation-status" aria-live="polite"></p></section>
	      </div></div>
    </section>
  </section>
</BaseLayout>

<script>
  import { createClient } from "@supabase/supabase-js";
  type ContentSummary = { id: string; title: string; slug: string; status: string; kind: string };
  type ContentDraft = { id: string; title: string; slug: string; status: string; excerpt: string | null; body_markdown: string | null; seo_title: string | null; seo_description: string | null; canonical_url: string | null; primary_media_id: string | null };
  type SourceDraft = { title: string; url: string; kind: "official" | "primary" | "secondary"; publisher: string; publishedAt: string; note: string; accessedAt?: string };
  type SocialDistribution = { accounts: Array<{ id: string; provider: string; display_name: string; external_account_ref: string | null; connection_status: string; updated_at: string }>; templates: Array<{ id: string; name: string; provider: string | null; body_template: string; enabled: boolean; updated_at: string }>; outbox: Array<{ id: string; body_snapshot: string; destination_url: string | null; status: string; created_at: string }>; activity: Array<{ id: number; outbox_id: string; action: string; note: string | null; created_at: string }>; publishedContent: Array<{ id: string; kind: string; title: string; slug: string; excerpt: string | null; published_at: string }> };
  type CommunityModeration = { questions: Array<{ id: string; title: string; body_markdown: string; status: string; created_at: string }>; answers: Array<{ id: string; question_id: string; body_markdown: string; status: string; created_at: string }>; reports: Array<{ id: number; target_type: string; target_id: string; reason: string; status: string; created_at: string }>; actions: Array<{ id: number; target_type: string; target_id: string; action: string; note: string | null; created_at: string }> };
  const authCard = document.querySelector<HTMLElement>("#auth-card")!;
  const dashboard = document.querySelector<HTMLElement>("#dashboard")!;
  const authStatus = document.querySelector<HTMLElement>("#auth-status")!;
  const developmentAccessCard = document.querySelector<HTMLElement>("#development-access-card")!;
  const developmentAccessStatus = document.querySelector<HTMLElement>("#development-access-status")!;
  const contentList = document.querySelector<HTMLUListElement>("#content-list")!;
  const draftStatus = document.querySelector<HTMLElement>("#draft-status")!;
  const editorPanel = document.querySelector<HTMLElement>("#editor-panel")!;
  const editorHeading = document.querySelector<HTMLElement>("#editor-heading")!;
  const editStatus = document.querySelector<HTMLElement>("#edit-status")!;
