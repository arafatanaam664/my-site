---
import "../styles/global.css";
import PushSubscriptionControl from "../components/PushSubscriptionControl.astro";
import { defaultSiteNotice } from "../lib/platform-settings";
import { organizationJsonLd, websiteJsonLd } from "../lib/site-schema";
import { publicFeatureState } from "../lib/server/feature-gates";
import { publicSiteNotice } from "../lib/server/platform-settings";

interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  pageType?: "website" | "article";
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const { title, description, canonical = "https://alshafra.com/", image, pageType = "website", noindex = false, jsonLd } = Astro.props;
const pageSchemas = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const schemas = [organizationJsonLd, websiteJsonLd, ...pageSchemas];
const safeJsonLd = JSON.stringify(schemas).replace(/</g, "\\u003c");
const siteNotice = await publicSiteNotice().catch(() => defaultSiteNotice);
const features = await publicFeatureState();
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex,follow" : "index,follow,max-image-preview:large"} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={pageType} />
    <meta property="og:locale" content="ar_AR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content="summary_large_image" />
    {image && <meta name="twitter:image" content={image} />}
    <script is:inline type="application/ld+json" set:html={safeJsonLd} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">تخطَّ إلى المحتوى الرئيسي</a>
    <header class="site-header">
      <a class="brand" href="/" aria-label="العودة إلى الرئيسية"><span class="brand-mark" aria-hidden="true">ش</span><span>Alshafra</span></a>
      <button type="button" class="nav-toggle" aria-expanded="false" aria-controls="primary-navigation">القائمة</button>
      <nav id="primary-navigation" aria-label="التنقل الرئيسي">
        <a href="/#solutions">الحلول</a>
        {features.tools_core && <a href="/tools">الأدوات</a>}
        {features.content_core && <a href="/guides">الأدلة</a>}
        {features.content_core && <a href="/solutions">الحلول العملية</a>}
        <a href="/calendar">التقويم والمواعيد</a>
        {features.community && <a href="/community">المجتمع</a>}
      </nav>
      <a class="header-search" href="/search">ابحث في Alshafra <span aria-hidden="true">⌕</span></a>
    </header>
    {siteNotice.enabled && siteNotice.message && <aside class="site-notice" aria-label="تنبيه من المنصة"><p>{siteNotice.message}</p></aside>}
    <main id="main-content" tabindex="-1"><slot /></main>
    <footer class="site-footer">
      <div><a class="brand" href="/"><span class="brand-mark" aria-hidden="true">ش</span><span>Alshafra</span></a><p>منصة عربية للمعرفة والإنجاز: بحث، محتوى، أدوات، ومجتمع يُفتح عند جاهزيته.</p></div>
      <div class="footer-links">
        {features.tools_core && <a href="/tools">الأدوات</a>}
        {features.content_core && <a href="/guides">الأدلة</a>}
        {features.content_core && <a href="/solutions">الحلول</a>}
        <a href="/calendar">التقويم والمواعيد</a>
        {features.community && <a href="/community">المجتمع</a>}
      </div>
      <div class="footer-links footer-trust">
        <a href="/legal/about">من نحن</a>
        <a href="/legal/privacy">الخصوصية</a>
        <a href="/legal/terms">الشروط</a>
        <a href="/legal/cookies">ملفات الارتباط</a>
        <a href="/legal/ads">الإعلانات</a>
        <a href="/legal/methodology">المنهجية</a>
        <a href="/legal/copyright">الحقوق</a>
        <a href="/legal/contact">اتصل بنا</a>
      </div>
    </footer>
    <PushSubscriptionControl />
    <section class="consent-card" id="analytics-consent" hidden aria-label="خيارات قياس الزيارة"><p>نستخدم قياسًا مجهّلًا واختياريًا لفهم قراءة المحتوى وتحسينه. لا نرسل عنوان IP أو اسمك أو بصمة جهازك.</p><div><button type="button" id="analytics-allow">السماح بالقياس</button><button type="button" id="analytics-decline">عدم السماح</button><a href="/legal/privacy">سياسة الخصوصية</a></div></section>
    <script is:inline>
      (() => {
        const toggle = document.querySelector(".nav-toggle");
        const nav = document.querySelector("#primary-navigation");
        toggle?.addEventListener("click", () => {
          const open = toggle.getAttribute("aria-expanded") === "true";
          toggle.setAttribute("aria-expanded", String(!open));
          nav?.classList.toggle("is-open", !open);
        });
        const consentKey = "alshafra_analytics_consent_v1"; const card = document.querySelector("#analytics-consent"); const article = document.querySelector("[data-analytics-content-id]"); let sent = new Set(); let started = Date.now();
        const consent = () => localStorage.getItem(consentKey); const sessionKey = "alshafra_analytics_session_v1";
        const session = () => { let id = sessionStorage.getItem(sessionKey); if (!id) { id = crypto.randomUUID(); sessionStorage.setItem(sessionKey, id); } return id; };
        let chain = Promise.resolve(); const send = (eventType, durationSeconds = null) => { if (consent() !== "granted" || sent.has(eventType)) return; sent.add(eventType); const payload = JSON.stringify({ path: location.pathname, eventType, contentId: article?.getAttribute("data-analytics-content-id") || null, durationSeconds, sessionId: session() }); chain = chain.then(() => fetch("/api/analytics/event", { method: "POST", body: payload, headers: { "content-type": "text/plain;charset=UTF-8" }, keepalive: true }).catch(() => {})); };
        const grant = () => { localStorage.setItem(consentKey, "granted"); card.hidden = true; send("page_view"); }; const decline = () => { localStorage.setItem(consentKey, "denied"); card.hidden = true; };
        if (!consent()) card.hidden = false; else if (consent() === "granted") send("page_view");
        document.querySelector("#analytics-allow")?.addEventListener("click", grant); document.querySelector("#analytics-decline")?.addEventListener("click", decline);
        addEventListener("alshafra:content-share", () => send("content_share"));
        if (article) { const depth = () => { const max = document.documentElement.scrollHeight - innerHeight; const percent = max > 0 ? (scrollY / max) * 100 : 100; if (percent >= 25) send("read_25"); if (percent >= 50) send("read_50"); if (percent >= 75) send("read_75"); if (percent >= 90) send("read_complete", Math.min(7200, Math.round((Date.now() - started) / 1000))); }; addEventListener("scroll", depth, { passive: true }); addEventListener("visibilitychange", () => { if (document.visibilityState === "hidden") depth(); }); }
      })();
    </script>
  </body>
</html>
